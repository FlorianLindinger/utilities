{
  "name": "Default",
  "settings": "{\"settings\":\"{\\r\\n  // =====================================\\r\\n  // general \\r\\n  \\\"settingsSync.ignoredSettings\\\": [ // Exclude from sync; -setting re-enables a default exclusion.\\r\\n    \\\"diffEditor.hideUnchangedRegions.enabled\\\"\\r\\n  ],\\r\\n  \\\"settingsSync.ignoredExtensions\\\": [],\\r\\n  \\\"workbench.startupEditor\\\": \\\"welcomePage\\\", // Show Welcome when no editor is restored.\\r\\n  \\\"workbench.editor.useModal\\\": \\\"off\\\", // off = open stuff in tab instead of popup\\r\\n  \\\"workbench.list.mouseWheelScrollSensitivity\\\": 2, // List/tree scroll speed multiplier.\\r\\n  \\\"workbench.browser.showInTitleBar\\\": false, // Hide the Integrated Browser title-bar button.\\r\\n  \\\"workbench.secondarySideBar.showLabels\\\": true,\\r\\n  \\\"window.newWindowProfile\\\": \\\"Default\\\",\\r\\n  \\\"window.density.layout\\\": \\\"compact\\\", // Reduce workbench spacing.\\r\\n  \\\"breadcrumbs.enabled\\\": true, // shows the current class/function below the editor tabs\\r\\n  \\\"breadcrumbs.symbolPath\\\": \\\"on\\\", // Include classes/functions in breadcrumbs.\\r\\n  \\\"security.workspace.trust.untrustedFiles\\\": \\\"open\\\", // Open untrusted files here without prompting.\\r\\n  \\\"security.promptForLocalFileProtocolHandling\\\": true, // Ask before opening file:// links.\\r\\n  \\\"files.autoSave\\\": \\\"afterDelay\\\", // Save after files.autoSaveDelay.\\r\\n  \\\"update.showReleaseNotes\\\": false,\\r\\n  \\\"files.associations\\\": { // Override file-language detection.\\r\\n    \\\"*.json\\\": \\\"jsonc\\\" // Allow comments and trailing commas in JSON editing.\\r\\n  },\\r\\n  // =====================================\\r\\n  // recommended extensions\\r\\n  \\\"recommendations\\\": [ // Belongs in .vscode/extensions.json, not user settings.\\r\\n    \\\"anthropic.claude-code\\\",\\r\\n    \\\"charliermarsh.ruff\\\",\\r\\n    \\\"donjayamanne.python-extension-pack\\\",\\r\\n    \\\"kevinrose.vsc-python-indent\\\",\\r\\n    \\\"mcu-debug.debug-tracker-vscode\\\",\\r\\n    \\\"mechatroner.rainbow-csv\\\",\\r\\n    \\\"meta.pyrefly\\\",\\r\\n    \\\"mhelbich.claude-code-usage-status\\\",\\r\\n    \\\"ms-python.python\\\",\\r\\n    \\\"ms-python.vscode-pylance\\\",\\r\\n    \\\"ms-toolsai.jupyter\\\",\\r\\n    \\\"ms-toolsai.jupyter-keymap\\\",\\r\\n    \\\"ms-toolsai.jupyter-renderers\\\",\\r\\n    \\\"ms-toolsai.vscode-jupyter-cell-tags\\\",\\r\\n    \\\"ms-toolsai.vscode-jupyter-powertoys\\\",\\r\\n    \\\"nilssoderman.batch-runner\\\",\\r\\n    \\\"njqdev.vscode-python-typehint\\\",\\r\\n    \\\"oderwat.indent-rainbow\\\",\\r\\n    \\\"openai.chatgpt\\\",\\r\\n    \\\"saysaeqo.python-cprofile\\\",\\r\\n    \\\"usernamehw.commands\\\"\\r\\n  ],\\r\\n  // =====================================\\r\\n  // terminal\\r\\n  \\\"terminal.integrated.enableMultiLinePasteWarning\\\": \\\"auto\\\", // Warn about potentially unsafe multiline pastes.\\r\\n  \\\"terminal.integrated.defaultProfile.windows\\\": \\\"Command Prompt UTF-8\\\",\\r\\n  \\\"terminal.integrated.profiles.windows\\\": { // Custom Windows shell profiles.\\r\\n    \\\"Command Prompt UTF-8\\\": {\\r\\n      \\\"path\\\": \\\"${env:windir}\\\\\\\\System32\\\\\\\\cmd.exe\\\", // Windows Command Prompt path.\\r\\n      \\\"args\\\": [\\r\\n        \\\"/K\\\", // Run startup command; keep cmd.exe open.\\r\\n        \\\"chcp 65001 > nul\\\" // Use UTF-8; hide confirmation.\\r\\n      ]\\r\\n    }\\r\\n  },\\r\\n  // =====================================\\r\\n  // file explorer and search\\r\\n  \\\"explorer.sortOrder\\\": \\\"type\\\", // \\\"type\\\" = file type; \\\"default\\\"=folder first + alphabetically\\r\\n  \\\"explorer.excludeGitIgnore\\\": true, // Hide .gitignore matches in Explorer.\\r\\n  \\\"explorer.confirmDelete\\\": true,\\r\\n  \\\"files.exclude\\\": { // not visible in explorer:\\r\\n    \\\"**/__pycache__\\\": true, // Python bytecode caches.\\r\\n    \\\"**/node_modules\\\": true, // JavaScript dependencies.\\r\\n    \\\"**/.venv\\\": true, // Local Python environments.\\r\\n    \\\"**/.gitattributes\\\": true, // Git file and line-ending rules.\\r\\n    \\\"**/*.lnk\\\": true, // Windows shortcuts.\\r\\n    \\\"**/*.lprof\\\": true, // Line-profiler output.\\r\\n    \\\"**/*.pid\\\": true, // Process ID files.\\r\\n    \\\"**/*.ome.tif\\\": true, // OME-TIFF microscopy images.\\r\\n    \\\"**/*.tiff\\\": true, // TIFF images; excludes plain .tif.\\r\\n    \\\"**/bin\\\": true, // compiled output folders\\r\\n    \\\"**/obj\\\": true, // temporary build folders\\r\\n    \\\"**/.agents\\\": true, // Agent instructions and support files.\\r\\n    \\\"**/.vscode\\\": true, // Workspace settings, tasks, and launch configs.\\r\\n    \\\"**/.ruff_cache\\\": true,\\r\\n    \\\"**/.codex\\\": true, // Codex config and support files.\\r\\n    \\\"**/.pytest_cache\\\": true, // Pytest cache, including previous failures.\\r\\n    \\\"**/*.pyc\\\": true // Compiled Python bytecode.\\r\\n  },\\r\\n  \\\"search.exclude\\\": { // inherits all from \\\"files.exclude\\\"\\r\\n  },\\r\\n  // =====================================\\r\\n  // default formatters\\r\\n  \\\"editor.formatOnSave\\\": true,\\r\\n  \\\"notebook.formatOnSave.enabled\\\": true,\\r\\n  \\\"[json]\\\": { // JSON-only overrides.\\r\\n    \\\"editor.defaultFormatter\\\": \\\"vscode.json-language-features\\\" // Built-in JSON formatter.\\r\\n  },\\r\\n  \\\"[jsonc]\\\": { // JSON-with-comments overrides.\\r\\n    \\\"editor.defaultFormatter\\\": \\\"vscode.json-language-features\\\" // Built-in JSON formatter.\\r\\n  },\\r\\n  \\\"notebook.defaultFormatter\\\": \\\"charliermarsh.ruff\\\", // Ruff notebook formatting.\\r\\n  // =====================================\\r\\n  // type checker settings\\r\\n  \\\"files.watcherExclude\\\": { // Skip file watching; does not hide files.\\r\\n    \\\"**/node_modules/**\\\": true,\\r\\n    \\\"**/.venv/**\\\": true\\r\\n  },\\r\\n  // =====================================\\r\\n  // editor\\r\\n  \\\"editor.hover.sticky\\\": true,\\r\\n  \\\"editor.hover.hidingDelay\\\": 500,\\r\\n  \\\"editor.accessibilitySupport\\\": \\\"off\\\", // Disable screen-reader optimizations.\\r\\n  \\\"editor.codeLens\\\": false, // Hide inline actions/reference counts.\\r\\n  \\\"editor.showFoldingControls\\\": \\\"always\\\", // Always show folding arrows.\\r\\n  \\\"editor.foldingStrategy\\\": \\\"auto\\\", // Language-aware folding; indentation fallback.\\r\\n  \\\"editor.suggest.showStatusBar\\\": true, // Show completion-popup status bar.\\r\\n  \\\"editor.mouseWheelZoom\\\": true, // Ctrl+wheel changes font size.\\r\\n  \\\"editor.insertSpaces\\\": true, // Tab inserts spaces; auto-detection may override.\\r\\n  \\\"editor.wordWrap\\\": \\\"on\\\", // Wrap at editor width; no added newlines.\\r\\n  \\\"editor.hover.delay\\\": 800, // Hover delay in milliseconds.\\r\\n  \\\"editor.mouseWheelScrollSensitivity\\\": 3, // Editor scroll speed multiplier.\\r\\n  \\\"editor.stickyScroll.enabled\\\": true, //pins enclosing function/class headers at the top while scrolling.\\r\\n  // =====================================\\r\\n  // diffs\\r\\n  \\\"diffEditor.ignoreTrimWhitespace\\\": false, // Include edge-whitespace changes in diffs.\\r\\n  \\\"diffEditor.maxComputationTime\\\": 0, // Diff timeout in ms; 0 = unlimited.\\r\\n  \\\"diffEditor.hideUnchangedRegions.enabled\\\": true, // not synced; Collapse unchanged diff sections.\\r\\n  // =====================================\\r\\n  // notebooks\\r\\n  \\\"notebook.compactView\\\": true, // Reduce cell spacing.\\r\\n  \\\"notebook.lineNumbers\\\": \\\"on\\\",\\r\\n  \\\"notebook.stickyScroll.enabled\\\": true, //pins enclosing function/class headers at the top while scrolling.\\r\\n  \\\"notebook.cellExecutionTimeVerbosity\\\": \\\"verbose\\\",\\r\\n  \\\"notebook.cellFocusIndicator\\\": \\\"border\\\", // Border around the focused cell.\\r\\n  \\\"notebook.dragAndDropEnabled\\\": true,\\r\\n  \\\"notebook.diff.overviewRuler\\\": true, // Show notebook diff navigation ruler.\\r\\n  \\\"notebook.globalToolbarShowLabel\\\": \\\"dynamic\\\", // Adapt toolbar labels to available space.\\r\\n  \\\"notebook.insertToolbarLocation\\\": \\\"hidden\\\", // insert cell button\\r\\n  \\\"notebook.output.scrolling\\\": true, // Scroll long outputs.\\r\\n  \\\"notebook.output.wordWrap\\\": true,\\r\\n  \\\"notebook.showCellStatusBar\\\": \\\"visible\\\",\\r\\n  \\\"notebook.variablesView\\\": true, // Show variables if the kernel supports it.\\r\\n  \\\"notebook.cellToolbarLocation\\\": { // Cell toolbar position by notebook type.\\r\\n    \\\"default\\\": \\\"hidden\\\" // Hide cell toolbars by default.\\r\\n  },\\r\\n  \\\"notebook.editorOptionsCustomizations\\\": { // Editor overrides for notebook cells.\\r\\n    \\\"editor.tabSize\\\": 4, // Display a tab as 4 spaces.\\r\\n    \\\"editor.indentSize\\\": 4, // Spaces per indentation level.\\r\\n    \\\"editor.insertSpaces\\\": true, // Tab inserts spaces; auto-detection may override.\\r\\n    \\\"editor.folding\\\": true,\\r\\n    \\\"editor.showFoldingControls\\\": \\\"always\\\" // Always show folding arrows.\\r\\n  }, // not synced; Virtual-environment search folder.\\r\\n  \\\"python.defaultInterpreterPath\\\": \\\"${env:USERPROFILE}\\\\\\\\Documents\\\\\\\\python_envs\\\\\\\\default_env\\\\\\\\Scripts\\\\\\\\python.exe\\\", // not synced; Initial default; does not override workspace selection.\\r\\n  \\\"python.analysis.inlayHints.variableTypes\\\": false, // Hide inferred variable-type hints.\\r\\n  \\\"python.analysis.inlayHints.functionReturnTypes\\\": true, // Show inferred return-type hints.\\r\\n  \\\"python.analysis.autoImportCompletions\\\": false, // not synced; Use Python extension environment handling. May reduce startup time.\\r\\n  \\\"python.testing.pytestEnabled\\\": false, // false = faster start\\r\\n  \\\"python.testing.unittestEnabled\\\": false, // Disable unittest discovery/integration.\\r\\n  \\\"python.experiments.optOutFrom\\\": [ // All opts out of every Python experiment.\\r\\n    \\\"All\\\"\\r\\n  ],\\r\\n  \\\"[python]\\\": { // Python-only overrides.\\r\\n    \\\"editor.defaultFormatter\\\": \\\"charliermarsh.ruff\\\", // Ruff formatter.\\r\\n    \\\"editor.codeActionsOnSave\\\": { // Code actions to run on save.\\r\\n      \\\"source.organizeImports.ruff\\\": \\\"explicit\\\", // Sort imports on explicit saves only.\\r\\n      \\\"source.addMissingImports\\\": \\\"never\\\" // Do not add imports on save.\\r\\n    }\\r\\n  },\\r\\n  // =====================================\\r\\n  // jupyter (notebooks)\\r\\n  \\\"jupyter.disableJupyterAutoStart\\\": false, // Allow automatic Jupyter startup.\\r\\n  \\\"jupyter.widgetScriptSources\\\": [ // Allowed widget JavaScript CDNs.\\r\\n    \\\"jsdelivr.com\\\",\\r\\n    \\\"unpkg.com\\\"\\r\\n  ], //needed for interactive\\r\\n  \\\"jupyter.askForKernelRestart\\\": false, // Restart kernels without confirmation.\\r\\n  \\\"[jupyter]\\\": { // jupyter-language overrides; not all notebook cells.\\r\\n    \\\"editor.mouseWheelScrollSensitivity\\\": 3.5 // Editor scroll speed multiplier.\\r\\n  },\\r\\n  // =====================================\\r\\n  // copilot/chat/AI\\r\\n  \\\"github.copilot.nextEditSuggestions.enabled\\\": true, // Suggest related code changes after editing\\r\\n  \\\"github.copilot.enable\\\": { // Completions by language; entries override *.\\r\\n    \\\"*\\\": true, // Default on; language overrides below.\\r\\n    \\\"plaintext\\\": false,\\r\\n    \\\"markdown\\\": false,\\r\\n    \\\"scminput\\\": false,\\r\\n    \\\"log\\\": false,\\r\\n    \\\"git-commit\\\": false,\\r\\n    \\\"git-rebase\\\": false,\\r\\n    \\\"restructuredtext\\\": false,\\r\\n    \\\"asciidoc\\\": false,\\r\\n    \\\"json\\\": false,\\r\\n    \\\"jsonc\\\": false,\\r\\n    \\\"latex\\\": false,\\r\\n    \\\"tex\\\": false,\\r\\n    \\\"typst\\\": false,\\r\\n    \\\"yaml\\\": false,\\r\\n    \\\"toml\\\": false,\\r\\n    \\\"ini\\\": false,\\r\\n    \\\"properties\\\": false,\\r\\n    \\\"csv\\\": false,\\r\\n    \\\"tsv\\\": false,\\r\\n    \\\"diff\\\": false\\r\\n  },\\r\\n  \\\"chat.disableAIFeatures\\\": false, // true = disable copilot (->faster start)\\r\\n  \\\"chat.titleBar.openInAgentsWindow.enabled\\\": false, // Hide the Open in Agents Window option.\\r\\n  \\\"chat.tools.terminal.autoApprove\\\": { // Auto-approve matching chat terminal commands.\\r\\n    \\\"/^python -m py_compile live_plot\\\\\\\\.py$/\\\": { // Match this exact syntax-check command.\\r\\n      \\\"approve\\\": true, // Allow matching commands.\\r\\n      \\\"matchCommandLine\\\": true // Match the full command line.\\r\\n    }\\r\\n  },\\r\\n  \\\"editor.quickSuggestions\\\": { // Automatic completion popups by context.\\r\\n    \\\"other\\\": true, // Suggest in code.\\r\\n    \\\"comments\\\": false, // No automatic suggestions in comments.\\r\\n    \\\"strings\\\": false // No automatic suggestions in strings.\\r\\n  },\\r\\n  // =====================================\\r\\n  // Ruff - extension - formatter/linter settings (python)\\r\\n  \\\"ruff.configuration\\\": \\\"D:/Users/IRScope/Documents/Repositories/utilities/python_related/good_Ruff_settings.toml\\\", // Shared Ruff config; precedence set below.\\r\\n  \\\"ruff.configurationPreference\\\": \\\"filesystemFirst\\\", // Local TOML wins; editorFirst reverses, editorOnly skips TOML.\\r\\n  \\\"ruff.lint.enable\\\": true, // Enable linting independently of formatting.\\r\\n  \\\"ruff.lint.preview\\\": false,\\r\\n  \\\"ruff.logLevel\\\": \\\"info\\\", // Log info, warnings, and errors.\\r\\n  // =====================================\\r\\n  // pyrefly - extension - type checker and LSP (alternative to pylance)\\r\\n  \\\"python.languageServer\\\": \\\"None\\\", // \\\"Default\\\"=Pylance \\\"None\\\"=Pyrefly\\r\\n  \\\"python.pyrefly.typeCheckingMode\\\": \\\"default\\\", // Preset only when no pyrefly.toml applies.\\r\\n  \\\"python.pyrefly.disableTypeErrors\\\": false, // Show type errors.\\r\\n  // =====================================\\r\\n  // git - extension\\r\\n  \\\"git.autoRepositoryDetection\\\": true,\\r\\n  \\\"git.enableSmartCommit\\\": true, // Allow committing all changes if none are staged.\\r\\n  \\\"git.autofetch\\\": true, // Fetch periodically; does not merge.\\r\\n  \\\"git.autofetchPeriod\\\": 600, // Fetch every 600 seconds (10 min).\\r\\n  \\\"git.confirmSync\\\": false, // Skip Git Sync confirmation (pull/push).\\r\\n  \\\"git.openRepositoryInParentFolders\\\": \\\"always\\\", // Open Git repositories above the workspace.\\r\\n  \\\"git.postCommitCommand\\\": \\\"push\\\", // Push after commits made through VS Code.\\r\\n  // =====================================\\r\\n  \\\"gitlens.currentLine.enabled\\\": true, // Show Git blame for the current line\\r\\n  \\\"gitlens.codeLens.enabled\\\": false, // Hide Git annotations above functions/classes\\r\\n  \\\"gitlens.hovers.enabled\\\": true, // Enable Git commit information on hover\\r\\n  \\\"gitlens.hovers.currentLine.over\\\": \\\"annotation\\\", // Show hover only over blame annotation\\r\\n  \\\"gitlens.statusBar.enabled\\\": false, // Hide GitLens information in the status bar\\r\\n  \\\"gitlens.blame.compact\\\": true, // Reduce repeated author information in file blame\\r\\n  // =====================================\\r\\n  // Github - extension\\r\\n  \\\"githubPullRequests.pushBranch\\\": \\\"always\\\", // Push missing remote source branches when creating PRs.\\r\\n  // =====================================\\r\\n  // codex/chatgpt extensions\\r\\n  \\\"codexUsage.showRemaining\\\": true, // Show quota remaining, not used.\\r\\n  \\\"codexUsage.compactStatusBar\\\": false, // Show full usage details.\\r\\n  \\\"chatgpt.openOnStartup\\\": false, // Keep the Codex/ChatGPT view closed at startup.\\r\\n  // =====================================\\r\\n  // Claude Code & Claude usage - extensions\\r\\n  \\\"claudeCode.preferredLocation\\\": \\\"panel\\\",\\r\\n  \\\"claudeCode.hideOnboarding\\\": true,\\r\\n  \\\"claudeCode.archiveInactiveSessions\\\": 0, // in days. 0 for disable\\r\\n  \\\"claudeUsage.dangerThreshold\\\": 75,\\r\\n  \\\"claudeUsage.warningThreshold\\\": 50,\\r\\n  \\\"claudeUsage.showUsed\\\": true,\\r\\n  \\\"claudeCode.enableReopenClosedSessionShortcut\\\": false,\\r\\n  \\\"claudeCode.focusView\\\": true,\\r\\n  \\\"claudeCode.scrollToBottomOnSend\\\": false,\\r\\n  // =====================================\\r\\n  // Code Spell Checker - extension\\r\\n  \\\"cSpell.enabled\\\": true,\\r\\n  \\\"cSpell.language\\\": \\\"en\\\",\\r\\n  \\\"cSpell.autocorrect\\\": false, // Keep spelling corrections manual while typing.\\r\\n  \\\"cSpell.diagnosticLevel\\\": \\\"Hint\\\", // Show spelling hints in the editor; omit them from Problems.\\r\\n  \\\"cSpell.hideIssuesWhileTyping\\\": \\\"Word\\\", // Temporarily hide issues in the word currently being edited.\\r\\n  \\\"cSpell.enabledSchemes\\\": { // Enable checking by document URI scheme.\\r\\n    \\\"vscode-scm\\\": true // vscode GUI\\r\\n  },\\r\\n  \\\"cSpell.enabledFileTypes\\\": { // Enable checking by VS Code language ID.\\r\\n    \\\"scminput\\\": true // vscode GUI\\r\\n  },\\r\\n  \\\"cSpell.userWords\\\": [\\r\\n    \\\"DONT_CHANGE\\\",\\r\\n    \\\"LightwaveExplorer\\\",\\r\\n    \\\"NumPy\\\",\\r\\n    \\\"pybaselines\\\",\\r\\n    \\\"Pyrefly\\\",\\r\\n    \\\"pytest\\\",\\r\\n    \\\"SciPy\\\"\\r\\n  ],\\r\\n  // =====================================\\r\\n  // buttons in GUI using \\\"Commands\\\"-extension\\r\\n  \\\"commands.commands\\\": { // Custom Commands actions, menus, and buttons.\\r\\n    \\\"Copilot autocomplete\\\": {\\r\\n      \\\"sequence\\\": [ // Run actions in order.\\r\\n        {\\r\\n          \\\"command\\\": \\\"commands.toggleSetting\\\",\\r\\n          \\\"args\\\": {\\r\\n            \\\"setting\\\": \\\"github.copilot.enable\\\",\\r\\n            \\\"value\\\": [ // Cycle values; one value always applies it.\\r\\n              {\\r\\n                \\\"*\\\": true, // Default on; language overrides below.\\r\\n                \\\"plaintext\\\": false,\\r\\n                \\\"markdown\\\": false,\\r\\n                \\\"scminput\\\": false,\\r\\n                \\\"log\\\": false,\\r\\n                \\\"git-commit\\\": false,\\r\\n                \\\"git-rebase\\\": false,\\r\\n                \\\"restructuredtext\\\": false,\\r\\n                \\\"asciidoc\\\": false,\\r\\n                \\\"json\\\": false,\\r\\n                \\\"jsonc\\\": false,\\r\\n                \\\"latex\\\": false,\\r\\n                \\\"tex\\\": false,\\r\\n                \\\"typst\\\": false,\\r\\n                \\\"yaml\\\": false,\\r\\n                \\\"toml\\\": false,\\r\\n                \\\"ini\\\": false,\\r\\n                \\\"properties\\\": false,\\r\\n                \\\"csv\\\": false,\\r\\n                \\\"tsv\\\": false,\\r\\n                \\\"diff\\\": false\\r\\n              },\\r\\n              {\\r\\n                \\\"*\\\": false, // Default off.\\r\\n                \\\"plaintext\\\": false,\\r\\n                \\\"markdown\\\": false,\\r\\n                \\\"scminput\\\": false,\\r\\n                \\\"log\\\": false,\\r\\n                \\\"git-commit\\\": false,\\r\\n                \\\"git-rebase\\\": false,\\r\\n                \\\"restructuredtext\\\": false,\\r\\n                \\\"asciidoc\\\": false,\\r\\n                \\\"json\\\": false,\\r\\n                \\\"jsonc\\\": false,\\r\\n                \\\"latex\\\": false,\\r\\n                \\\"tex\\\": false,\\r\\n                \\\"typst\\\": false,\\r\\n                \\\"yaml\\\": false,\\r\\n                \\\"toml\\\": false,\\r\\n                \\\"ini\\\": false,\\r\\n                \\\"properties\\\": false,\\r\\n                \\\"csv\\\": false,\\r\\n                \\\"tsv\\\": false,\\r\\n                \\\"diff\\\": false\\r\\n              }\\r\\n            ],\\r\\n            \\\"target\\\": \\\"workspace\\\" // Apply to this workspace.\\r\\n          }\\r\\n        },\\r\\n        {\\r\\n          \\\"command\\\": \\\"commands.toggleSetting\\\",\\r\\n          \\\"args\\\": {\\r\\n            \\\"setting\\\": \\\"github.copilot.nextEditSuggestions.enabled\\\",\\r\\n            \\\"value\\\": [ // Cycle values; one value always applies it.\\r\\n              true,\\r\\n              false\\r\\n            ],\\r\\n            \\\"target\\\": \\\"workspace\\\"\\r\\n          }\\r\\n        }\\r\\n      ],\\r\\n      \\\"statusBar\\\": { // Clickable status-bar button.\\r\\n        \\\"alignment\\\": \\\"right\\\",\\r\\n        \\\"priority\\\": 100.09, // Higher = farther left within the group.\\r\\n        \\\"name\\\": \\\"Copilot autocomplete\\\",\\r\\n        \\\"text\\\": \\\"$(copilot)=${config:github.copilot.enable.*}\\\",\\r\\n        \\\"tooltip\\\": \\\"Toggle Copilot autocomplete for code and Next Edit Suggestions in this workspace. Prose, log files, and commit messages stay disabled for autocomplete.\\\",\\r\\n        \\\"replaceVariableValue\\\": { // Short labels for expanded config values.\\r\\n          \\\"config:github.copilot.enable.*\\\": {\\r\\n            \\\"true\\\": \\\"on\\\",\\r\\n            \\\"false\\\": \\\"off\\\"\\r\\n          }\\r\\n        },\\r\\n        \\\"updateEvents\\\": [ // Events that refresh the button.\\r\\n          {\\r\\n            \\\"kind\\\": \\\"onDidConfigurationChange\\\", // Refresh on configuration changes.\\r\\n            \\\"settings\\\": [ // Settings that trigger a refresh.\\r\\n              \\\"github.copilot.enable\\\",\\r\\n              \\\"github.copilot.nextEditSuggestions.enabled\\\"\\r\\n            ]\\r\\n          }\\r\\n        ]\\r\\n      }\\r\\n    },\\r\\n    // =====================================\\r\\n    // Ruff restarts by itself when these settings change.\\r\\n    // ruff.configuration must stay {} here: with filesystemFirst, a path in it is merged under the local file.\\r\\n    // Status bar shows lint enablement separately from configuration priority.\\r\\n    \\\"Ruff rules\\\": {\\r\\n      \\\"nestedItems\\\": { // Menu choices.\\r\\n        \\\"Off (formatter stays on)\\\": {\\r\\n          \\\"sequence\\\": [\\r\\n            {\\r\\n              \\\"command\\\": \\\"commands.toggleSetting\\\",\\r\\n              \\\"args\\\": {\\r\\n                \\\"setting\\\": \\\"ruff.lint.enable\\\",\\r\\n                \\\"value\\\": [ // Cycle values; one value always applies it.\\r\\n                  false\\r\\n                ],\\r\\n                \\\"target\\\": \\\"workspace\\\"\\r\\n              }\\r\\n            },\\r\\n            {\\r\\n              \\\"command\\\": \\\"commands.toggleSetting\\\",\\r\\n              \\\"args\\\": {\\r\\n                \\\"setting\\\": \\\"ruff.configurationPreference\\\",\\r\\n                \\\"value\\\": [ // Cycle values; one value always applies it.\\r\\n                  \\\"editorFirst\\\"\\r\\n                ],\\r\\n                \\\"target\\\": \\\"workspace\\\"\\r\\n              }\\r\\n            },\\r\\n            {\\r\\n              \\\"command\\\": \\\"commands.toggleSetting\\\",\\r\\n              \\\"args\\\": {\\r\\n                \\\"setting\\\": \\\"ruff.configuration\\\",\\r\\n                \\\"value\\\": [ // Cycle values; one value always applies it.\\r\\n                  {}\\r\\n                ],\\r\\n                \\\"target\\\": \\\"workspace\\\"\\r\\n              }\\r\\n            }\\r\\n          ]\\r\\n        },\\r\\n        \\\"Default (ignores local file)\\\": {\\r\\n          \\\"sequence\\\": [\\r\\n            {\\r\\n              \\\"command\\\": \\\"commands.toggleSetting\\\",\\r\\n              \\\"args\\\": {\\r\\n                \\\"setting\\\": \\\"ruff.lint.enable\\\",\\r\\n                \\\"value\\\": [ // Cycle values; one value always applies it.\\r\\n                  true\\r\\n                ],\\r\\n                \\\"target\\\": \\\"workspace\\\"\\r\\n              }\\r\\n            },\\r\\n            {\\r\\n              \\\"command\\\": \\\"commands.toggleSetting\\\",\\r\\n              \\\"args\\\": {\\r\\n                \\\"setting\\\": \\\"ruff.configurationPreference\\\",\\r\\n                \\\"value\\\": [ // Cycle values; one value always applies it.\\r\\n                  \\\"editorOnly\\\"\\r\\n                ],\\r\\n                \\\"target\\\": \\\"workspace\\\"\\r\\n              }\\r\\n            },\\r\\n            {\\r\\n              \\\"command\\\": \\\"commands.toggleSetting\\\",\\r\\n              \\\"args\\\": {\\r\\n                \\\"setting\\\": \\\"ruff.configuration\\\",\\r\\n                \\\"value\\\": [ // Cycle values; one value always applies it.\\r\\n                  {}\\r\\n                ],\\r\\n                \\\"target\\\": \\\"workspace\\\"\\r\\n              }\\r\\n            }\\r\\n          ]\\r\\n        },\\r\\n        \\\"Local file (defaults if none)\\\": {\\r\\n          \\\"sequence\\\": [\\r\\n            {\\r\\n              \\\"command\\\": \\\"commands.toggleSetting\\\",\\r\\n              \\\"args\\\": {\\r\\n                \\\"setting\\\": \\\"ruff.lint.enable\\\",\\r\\n                \\\"value\\\": [ // Cycle values; one value always applies it.\\r\\n                  true\\r\\n                ],\\r\\n                \\\"target\\\": \\\"workspace\\\"\\r\\n              }\\r\\n            },\\r\\n            {\\r\\n              \\\"command\\\": \\\"commands.toggleSetting\\\",\\r\\n              \\\"args\\\": {\\r\\n                \\\"setting\\\": \\\"ruff.configurationPreference\\\",\\r\\n                \\\"value\\\": [ // Cycle values; one value always applies it.\\r\\n                  \\\"filesystemFirst\\\"\\r\\n                ],\\r\\n                \\\"target\\\": \\\"workspace\\\"\\r\\n              }\\r\\n            },\\r\\n            {\\r\\n              \\\"command\\\": \\\"commands.toggleSetting\\\",\\r\\n              \\\"args\\\": {\\r\\n                \\\"setting\\\": \\\"ruff.configuration\\\",\\r\\n                \\\"value\\\": [ // Cycle values; one value always applies it.\\r\\n                  {}\\r\\n                ],\\r\\n                \\\"target\\\": \\\"workspace\\\"\\r\\n              }\\r\\n            }\\r\\n          ]\\r\\n        }\\r\\n      },\\r\\n      \\\"statusBar\\\": {\\r\\n        \\\"alignment\\\": \\\"right\\\",\\r\\n        \\\"name\\\": \\\"Ruff rules\\\",\\r\\n        \\\"text\\\": \\\"Ruff:${config:ruff.configurationPreference}\\\",\\r\\n        \\\"tooltip\\\": \\\"Configured Ruff lint state and configuration priority. Choose a preset; formatting stays enabled.\\\",\\r\\n        \\\"replaceVariableValue\\\": { // Short labels for expanded config values.\\r\\n          \\\"config:ruff.lint.enable\\\": {\\r\\n            \\\"true\\\": \\\"On\\\",\\r\\n            \\\"false\\\": \\\"Off\\\"\\r\\n          },\\r\\n          \\\"config:ruff.configurationPreference\\\": {\\r\\n            \\\"\\\\\\\"editorFirst\\\\\\\"\\\": \\\"Editor first\\\",\\r\\n            \\\"\\\\\\\"editorOnly\\\\\\\"\\\": \\\"Editor only\\\",\\r\\n            \\\"\\\\\\\"filesystemFirst\\\\\\\"\\\": \\\"Local first\\\"\\r\\n          }\\r\\n        },\\r\\n        \\\"updateEvents\\\": [ // Events that refresh the button.\\r\\n          {\\r\\n            \\\"kind\\\": \\\"onDidConfigurationChange\\\", // Refresh on configuration changes.\\r\\n            \\\"settings\\\": [ // Settings that trigger a refresh.\\r\\n              \\\"ruff.lint.enable\\\",\\r\\n              \\\"ruff.configurationPreference\\\"\\r\\n            ]\\r\\n          }\\r\\n        ]\\r\\n      }\\r\\n    },\\r\\n    // =====================================\\r\\n    // Presets apply when no project pyrefly.toml covers the file.\\r\\n    // Pyrefly ignores typeCheckingMode for files covered by a pyrefly.toml, even an empty one.\\r\\n    // Off needs disableTypeErrors because typeCheckingMode \\\"off\\\" is ignored there too.\\r\\n    \\\"Pyrefly type checking\\\": {\\r\\n      \\\"nestedItems\\\": {\\r\\n        \\\"Off\\\": {\\r\\n          \\\"sequence\\\": [\\r\\n            {\\r\\n              \\\"command\\\": \\\"commands.toggleSetting\\\",\\r\\n              \\\"args\\\": {\\r\\n                \\\"setting\\\": \\\"python.pyrefly.disableTypeErrors\\\",\\r\\n                \\\"value\\\": [\\r\\n                  true\\r\\n                ],\\r\\n                \\\"target\\\": \\\"workspace\\\"\\r\\n              }\\r\\n            },\\r\\n            {\\r\\n              \\\"command\\\": \\\"commands.toggleSetting\\\",\\r\\n              \\\"args\\\": {\\r\\n                \\\"setting\\\": \\\"python.pyrefly.configPath\\\",\\r\\n                \\\"value\\\": [\\r\\n                  \\\"\\\"\\r\\n                ],\\r\\n                \\\"target\\\": \\\"workspace\\\"\\r\\n              }\\r\\n            },\\r\\n            {\\r\\n              \\\"command\\\": \\\"commands.toggleSetting\\\",\\r\\n              \\\"args\\\": {\\r\\n                \\\"setting\\\": \\\"python.pyrefly.typeCheckingMode\\\",\\r\\n                \\\"value\\\": [\\r\\n                  \\\"off\\\"\\r\\n                ],\\r\\n                \\\"target\\\": \\\"workspace\\\"\\r\\n              }\\r\\n            },\\r\\n            \\\"pyrefly.restartClient\\\"\\r\\n          ]\\r\\n        },\\r\\n        \\\"Basic fallback\\\": {\\r\\n          \\\"sequence\\\": [\\r\\n            {\\r\\n              \\\"command\\\": \\\"commands.toggleSetting\\\",\\r\\n              \\\"args\\\": {\\r\\n                \\\"setting\\\": \\\"python.pyrefly.disableTypeErrors\\\",\\r\\n                \\\"value\\\": [\\r\\n                  false\\r\\n                ],\\r\\n                \\\"target\\\": \\\"workspace\\\"\\r\\n              }\\r\\n            },\\r\\n            {\\r\\n              \\\"command\\\": \\\"commands.toggleSetting\\\",\\r\\n              \\\"args\\\": {\\r\\n                \\\"setting\\\": \\\"python.pyrefly.configPath\\\",\\r\\n                \\\"value\\\": [\\r\\n                  \\\"\\\"\\r\\n                ],\\r\\n                \\\"target\\\": \\\"workspace\\\"\\r\\n              }\\r\\n            },\\r\\n            {\\r\\n              \\\"command\\\": \\\"commands.toggleSetting\\\",\\r\\n              \\\"args\\\": {\\r\\n                \\\"setting\\\": \\\"python.pyrefly.typeCheckingMode\\\",\\r\\n                \\\"value\\\": [\\r\\n                  \\\"basic\\\"\\r\\n                ],\\r\\n                \\\"target\\\": \\\"workspace\\\"\\r\\n              }\\r\\n            },\\r\\n            \\\"pyrefly.restartClient\\\",\\r\\n            {\\r\\n              \\\"command\\\": \\\"commands.showStatusBarNotification\\\",\\r\\n              \\\"args\\\": {\\r\\n                \\\"message\\\": \\\"$(warning) Pyrefly Basic: overridden wherever a pyrefly.toml applies\\\",\\r\\n                \\\"timeout\\\": 6000\\r\\n              }\\r\\n            }\\r\\n          ]\\r\\n        },\\r\\n        \\\"Default fallback\\\": {\\r\\n          \\\"sequence\\\": [\\r\\n            {\\r\\n              \\\"command\\\": \\\"commands.toggleSetting\\\",\\r\\n              \\\"args\\\": {\\r\\n                \\\"setting\\\": \\\"python.pyrefly.disableTypeErrors\\\",\\r\\n                \\\"value\\\": [\\r\\n                  false\\r\\n                ],\\r\\n                \\\"target\\\": \\\"workspace\\\"\\r\\n              }\\r\\n            },\\r\\n            {\\r\\n              \\\"command\\\": \\\"commands.toggleSetting\\\",\\r\\n              \\\"args\\\": {\\r\\n                \\\"setting\\\": \\\"python.pyrefly.configPath\\\",\\r\\n                \\\"value\\\": [\\r\\n                  \\\"\\\"\\r\\n                ],\\r\\n                \\\"target\\\": \\\"workspace\\\"\\r\\n              }\\r\\n            },\\r\\n            {\\r\\n              \\\"command\\\": \\\"commands.toggleSetting\\\",\\r\\n              \\\"args\\\": {\\r\\n                \\\"setting\\\": \\\"python.pyrefly.typeCheckingMode\\\",\\r\\n                \\\"value\\\": [\\r\\n                  \\\"default\\\"\\r\\n                ],\\r\\n                \\\"target\\\": \\\"workspace\\\"\\r\\n              }\\r\\n            },\\r\\n            \\\"pyrefly.restartClient\\\",\\r\\n            {\\r\\n              \\\"command\\\": \\\"commands.showStatusBarNotification\\\",\\r\\n              \\\"args\\\": {\\r\\n                \\\"message\\\": \\\"$(warning) Pyrefly Default: overridden wherever a pyrefly.toml applies\\\",\\r\\n                \\\"timeout\\\": 6000\\r\\n              }\\r\\n            }\\r\\n          ]\\r\\n        },\\r\\n        \\\"Strict fallback\\\": {\\r\\n          \\\"sequence\\\": [\\r\\n            {\\r\\n              \\\"command\\\": \\\"commands.toggleSetting\\\",\\r\\n              \\\"args\\\": {\\r\\n                \\\"setting\\\": \\\"python.pyrefly.disableTypeErrors\\\",\\r\\n                \\\"value\\\": [\\r\\n                  false\\r\\n                ],\\r\\n                \\\"target\\\": \\\"workspace\\\"\\r\\n              }\\r\\n            },\\r\\n            {\\r\\n              \\\"command\\\": \\\"commands.toggleSetting\\\",\\r\\n              \\\"args\\\": {\\r\\n                \\\"setting\\\": \\\"python.pyrefly.configPath\\\",\\r\\n                \\\"value\\\": [\\r\\n                  \\\"\\\"\\r\\n                ],\\r\\n                \\\"target\\\": \\\"workspace\\\"\\r\\n              }\\r\\n            },\\r\\n            {\\r\\n              \\\"command\\\": \\\"commands.toggleSetting\\\",\\r\\n              \\\"args\\\": {\\r\\n                \\\"setting\\\": \\\"python.pyrefly.typeCheckingMode\\\",\\r\\n                \\\"value\\\": [\\r\\n                  \\\"strict\\\"\\r\\n                ],\\r\\n                \\\"target\\\": \\\"workspace\\\"\\r\\n              }\\r\\n            },\\r\\n            \\\"pyrefly.restartClient\\\",\\r\\n            {\\r\\n              \\\"command\\\": \\\"commands.showStatusBarNotification\\\",\\r\\n              \\\"args\\\": {\\r\\n                \\\"message\\\": \\\"$(warning) Pyrefly Strict: overridden wherever a pyrefly.toml applies\\\",\\r\\n                \\\"timeout\\\": 6000\\r\\n              }\\r\\n            }\\r\\n          ]\\r\\n        }\\r\\n      },\\r\\n      \\\"statusBar\\\": {\\r\\n        \\\"alignment\\\": \\\"right\\\",\\r\\n        \\\"name\\\": \\\"Pyrefly type checking\\\",\\r\\n        \\\"text\\\": \\\"Pyrefly:${config:python.pyrefly.typeCheckingMode}\\\",\\r\\n        \\\"tooltip\\\": \\\"Type-error enablement and fallback preset. A project pyrefly.toml takes precedence over the fallback.\\\",\\r\\n        \\\"replaceVariableValue\\\": {\\r\\n          \\\"config:python.pyrefly.disableTypeErrors\\\": {\\r\\n            \\\"true\\\": \\\"Off\\\",\\r\\n            \\\"false\\\": \\\"On\\\"\\r\\n          },\\r\\n          \\\"config:python.pyrefly.typeCheckingMode\\\": {\\r\\n            \\\"\\\\\\\"off\\\\\\\"\\\": \\\"Off\\\",\\r\\n            \\\"\\\\\\\"basic\\\\\\\"\\\": \\\"Basic\\\",\\r\\n            \\\"\\\\\\\"default\\\\\\\"\\\": \\\"Default\\\",\\r\\n            \\\"\\\\\\\"strict\\\\\\\"\\\": \\\"Strict\\\",\\r\\n            \\\"\\\\\\\"auto\\\\\\\"\\\": \\\"Auto\\\",\\r\\n            \\\"\\\\\\\"legacy\\\\\\\"\\\": \\\"Legacy\\\",\\r\\n            \\\"\\\\\\\"all\\\\\\\"\\\": \\\"All\\\"\\r\\n          }\\r\\n        },\\r\\n        \\\"updateEvents\\\": [\\r\\n          {\\r\\n            \\\"kind\\\": \\\"onDidConfigurationChange\\\",\\r\\n            \\\"settings\\\": [\\r\\n              \\\"python.pyrefly.disableTypeErrors\\\",\\r\\n              \\\"python.pyrefly.typeCheckingMode\\\"\\r\\n            ]\\r\\n          }\\r\\n        ]\\r\\n      }\\r\\n    },\\r\\n    // =====================================\\r\\n    \\\"Run current C# project\\\": {\\r\\n      \\\"command\\\": \\\"commands.runInTerminal\\\",\\r\\n      \\\"args\\\": {\\r\\n        // Ctrl+C, find nearest .csproj, run newest matching bin EXE; no build.\\r\\n        \\\"text\\\": \\\"\\\\u0003@powershell -NoProfile -Command \\\\\\\"$dir = '${fileDirname}'; while ($dir -and -not (Get-ChildItem -LiteralPath $dir -Filter *.csproj -File -ErrorAction SilentlyContinue)) { $parent = Split-Path $dir -Parent; if ($parent -eq $dir) { break }; $dir = $parent }; $project = Get-ChildItem -LiteralPath $dir -Filter *.csproj -File | Select-Object -First 1; if (-not $project) { Write-Error 'No .csproj found above the active file'; exit 1 }; $exe = Get-ChildItem -LiteralPath (Join-Path $dir 'bin') -Filter ($project.BaseName + '.exe') -File -Recurse -ErrorAction SilentlyContinue | Sort-Object LastWriteTime -Descending | Select-Object -First 1; if (-not $exe) { Write-Error 'No compiled EXE found. Build the project first.'; exit 1 }; $configuration = if ($exe.FullName -match '\\\\\\\\\\\\\\\\bin\\\\\\\\\\\\\\\\Debug\\\\\\\\\\\\\\\\') { 'Debug' } elseif ($exe.FullName -match '\\\\\\\\\\\\\\\\bin\\\\\\\\\\\\\\\\Release\\\\\\\\\\\\\\\\') { 'Release' } else { 'Unknown' }; Write-Host ''; Write-Host '============================================================'; Write-Host ('Running:    ' + $configuration); Write-Host ('Built:      ' + $exe.LastWriteTime.ToString('yyyy-MM-dd HH:mm:ss')); Write-Host ('Path:       ' + $exe.FullName); Write-Host '============================================================'; Write-Host ''; & $exe.FullName\\\\\\\"\\\",\\r\\n        \\\"name\\\": \\\"C# EXE\\\",\\r\\n        \\\"reuse\\\": \\\"newest\\\", // Reuse newest same-named terminal; create if absent.\\r\\n        \\\"reveal\\\": true // Show the terminal.\\r\\n      },\\r\\n      \\\"activeEditorGlob\\\": \\\"**/*.{cs,csproj,xml,config,resx,props,targets,xaml}\\\", // Show only for matching active files.\\r\\n      \\\"statusBar\\\": {\\r\\n        \\\"text\\\": \\\"$(play) Run EXE\\\",\\r\\n        \\\"alignment\\\": \\\"right\\\",\\r\\n        \\\"priority\\\": 100, // Higher = farther left within the group.\\r\\n        \\\"tooltip\\\": \\\"Run the newest compiled EXE for the active C# project\\\",\\r\\n        \\\"activeEditorGlob\\\": \\\"**/*.{cs,csproj,xml,config,resx,props,targets,xaml}\\\" // Show only for matching active files.\\r\\n      }\\r\\n    }\\r\\n  },\\r\\n  // =====================================\\r\\n  // java - extension\\r\\n  \\\"js/ts.tsserver.watchOptions\\\": \\\"vscode\\\", // Use VS Code file watching for JS/TS.\\r\\n  \\\"jdk.telemetry.enabled\\\": false,\\r\\n  \\\"java.configuration.runtimes\\\": [\\r\\n    {\\r\\n      \\\"name\\\": \\\"JavaSE-25\\\",\\r\\n      \\\"path\\\": \\\"D:/Programs/Java\\\",\\r\\n      \\\"default\\\": true\\r\\n    }\\r\\n  ],\\r\\n  // =====================================\\r\\n  // C/C++ - extension \\r\\n  \\\"[cpp]\\\": { // C++-only overrides.\\r\\n    \\\"editor.defaultFormatter\\\": \\\"ms-vscode.cpptools\\\" // Microsoft C/C++ formatter.\\r\\n  },\\r\\n  \\\"[c]\\\": { // C-only overrides.\\r\\n    \\\"editor.defaultFormatter\\\": \\\"ms-vscode.cpptools\\\" // Microsoft C/C++ formatter.\\r\\n  },\\r\\n  // =====================================\\r\\n  // C# - extension\\r\\n  \\\"csharp.debug.console\\\": \\\"integratedTerminal\\\", // C# debugger I/O in the terminal.\\r\\n  \\\"dotnet.server.useOmnisharp\\\": false, // Use the modern Roslyn language server\\r\\n  \\\"[csharp]\\\": { // C#-only overrides.\\r\\n    \\\"editor.defaultFormatter\\\": \\\"ms-dotnettools.csharp\\\", // Use Microsoft's C# formatter\\r\\n    \\\"editor.formatOnSave\\\": true,\\r\\n    \\\"editor.inlayHints.enabled\\\": \\\"on\\\", // \\\"off\\\"=Hide parameter and type hints inside the code\\r\\n    \\\"editor.codeActionsOnSave\\\": { // Code actions to run on save.\\r\\n      \\\"source.organizeImports\\\": \\\"always\\\" // \\\"always\\\"= automatically sort and remove unused \\\"using\\\"-directives on save\\r\\n    },\\r\\n    \\\"editor.acceptSuggestionOnCommitCharacter\\\": false // Do not accept suggestions when typing punctuation\\r\\n  },\\r\\n  // =====================================\\r\\n  // =====================================\\r\\n  \\\"NEW_SETTINGS_ARE_BELOW\\\": \\\"\\\" // <-- NEW SETTING\\r\\n}\"}",
