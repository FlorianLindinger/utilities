{
  // =====================================
  // general 
  "workbench.editor.useModal": "off", // off = open stuff in tab instead of popup
  "workbench.list.mouseWheelScrollSensitivity": 2,
  "workbench.browser.showInTitleBar": false,
  "workbench.secondarySideBar.showLabels": true,
  "window.newWindowProfile": "Default",
  "window.density.layout": "compact",
  "breadcrumbs.enabled": true,
  "files.autoSave": "afterDelay",
  "security.workspace.trust.untrustedFiles": "open",
  "update.showReleaseNotes": false,
  // =====================================
  // terminal
  "terminal.integrated.enableMultiLinePasteWarning": "auto",
  "terminal.integrated.defaultProfile.windows": "Command Prompt UTF-8",
  "terminal.integrated.profiles.windows": {
    "Command Prompt UTF-8": {
      "path": "${env:windir}\\System32\\cmd.exe",
      "args": [
        "/K",
        "chcp 65001 > nul"
      ]
    }
  },
  // =====================================
  // file explorer and search
  "explorer.excludeGitIgnore": true,
  "explorer.confirmDelete": true,
  "files.exclude": { // not visible in explorer:
    "**/__pycache__": true,
    "**/node_modules": true,
    "**/.venv": true,
    "**/.gitattributes": true,
    "**/*.lnk": true,
    "**/*.lprof": true,
    "**/*.pid": true,
    "**/*.ome.tif": true,
    "**/*.tiff": true,
    "**/bin": true, // compiled output folders
    "**/obj": true, // temporary build folders
    "**/.agents": true,
    "**/.vscode": true,
    "**/.ruff_cache": true,
    "**/.codex": true,
    "**/.pytest_cache": true,
    "**/*.pyc": true,
  },
  "search.exclude": { // inherits all from "files.exclude"
  },
  // =====================================
  // default formatters
  "editor.formatOnSave": true,
  "notebook.formatOnSave.enabled": true,
  "[cpp]": {
    "editor.defaultFormatter": "ms-vscode.cpptools"
  }, // if "C/C++" extension installed
  "[c]": {
    "editor.defaultFormatter": "ms-vscode.cpptools"
  }, // if "C/C++" extension installed
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "notebook.defaultFormatter": "charliermarsh.ruff",
  // =====================================
  // git & diff & github
  "git.enableSmartCommit": true,
  "git.autofetch": true,
  "git.autofetchPeriod": 600, // seconds
  "git.confirmSync": false,
  "git.openRepositoryInParentFolders": "always",
  "git.postCommitCommand": "push",
  "githubPullRequests.pushBranch": "always",
  "diffEditor.ignoreTrimWhitespace": false,
  "diffEditor.maxComputationTime": 0,
  "diffEditor.hideUnchangedRegions.enabled": true,
  // =====================================
  // editor  
  "editor.codeLens": false,
  "editor.showFoldingControls": "always",
  "editor.foldingStrategy": "auto",
  "editor.suggest.showStatusBar": true,
  "editor.mouseWheelZoom": true,
  "editor.insertSpaces": true,
  "editor.wordWrap": "on",
  "editor.hover.delay": 800,
  "editor.mouseWheelScrollSensitivity": 3,
  // =====================================
  // notebooks
  "notebook.compactView": true,
  "notebook.lineNumbers": "on",
  "notebook.stickyScroll.enabled": true,
  "notebook.cellExecutionTimeVerbosity": "verbose",
  "notebook.cellFocusIndicator": "border",
  "notebook.dragAndDropEnabled": true,
  "notebook.diff.overviewRuler": true,
  "notebook.globalToolbarShowLabel": "dynamic",
  "notebook.insertToolbarLocation": "hidden", // insert cell button
  "notebook.output.scrolling": true,
  "notebook.output.wordWrap": true,
  "notebook.showCellStatusBar": "visible",
  "notebook.variablesView": true,
  "jupyter.widgetScriptSources": [
    "jsdelivr.com",
    "unpkg.com"
  ], //needed for interactive
  "jupyter.askForKernelRestart": false,
  "[jupyter]": {
    "editor.mouseWheelScrollSensitivity": 3.5
  },
  "notebook.cellToolbarLocation": {
    "default": "hidden"
  },
  "notebook.editorOptionsCustomizations": {
    "editor.tabSize": 4,
    "editor.indentSize": 4,
    "editor.insertSpaces": true,
    "editor.folding": true,
    "editor.showFoldingControls": "always"
  },
  // =====================================
  // vscode
  "settingsSync.ignoredExtensions": [],
  "settingsSync.ignoredSettings": [],
  // =====================================
  // codex
  "codexUsage.showRemaining": true,
  "codexUsage.compactStatusBar": false,
  // =====================================
  // copilot/chat/AI
  "github.copilot.nextEditSuggestions.enabled": true, // Suggest related code changes after editing
  "github.copilot.enable": {
    "*": false, //includes txt,md,git commit message panel
    "python": true
  },
  "chat.disableAIFeatures": false, // true = disable copilot (->faster start)
  "chat.titleBar.openInAgentsWindow.enabled": false,
  "chat.tools.terminal.autoApprove": {
    "/^python -m py_compile live_plot\\.py$/": {
      "approve": true,
      "matchCommandLine": true
    }
  },
  "editor.quickSuggestions": {
    "other": true,
    "comments": false,
    "strings": false
  },
  // =====================================
  // Python
  "python.useEnvironmentsExtension": false, // could be faster startup
  "python.testing.pytestEnabled": false, // false = faster start
  "python.defaultInterpreterPath": "..\\..\\python_envs\\default_env\\Scripts\\python.exe",
  "python-envs.globalSearchPaths": [
    "..\\..\\python_envs"
  ],
  "python.testing.unittestEnabled": false,
  "python.experiments.optOutFrom": [
    "All"
  ],
  "python.analysis.inlayHints.variableTypes": false,
  "python.analysis.inlayHints.functionReturnTypes": false,
  "python.analysis.autoImportCompletions": false,
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.codeActionsOnSave": {
      "source.organizeImports.ruff": "explicit",
      "source.addMissingImports": "never"
    }
  },
  // =====================================
  // java
  "js/ts.tsserver.watchOptions": "vscode",
  "jdk.telemetry.enabled": false,
  "java.configuration.runtimes": [
    {
      "name": "JavaSE-25",
      "path": "C:\\Program Files\\Java\\jdk-25.0.2",
      "default": true
    }
  ],
  // =====================================
  // C#
  "csharp.debug.console": "integratedTerminal",
  "dotnet.server.useOmnisharp": false, // Use the modern Roslyn language server
  "[csharp]": {
    "editor.defaultFormatter": "ms-dotnettools.csharp", // Use Microsoft's C# formatter
    "editor.formatOnSave": true, // Format C# files when saving
    "editor.inlayHints.enabled": "on", // "off"=Hide parameter and type hints inside the code
    "editor.codeActionsOnSave": {
      "source.organizeImports": "always" // "always"= automatically sort and remove unused "using"-directives on save
    },
    "editor.acceptSuggestionOnCommitCharacter": false, // Do not accept suggestions when typing punctuation
  },
  // =====================================
  // autodocstring
  "autoDocstring.docstringFormat": "numpy",
  "autoDocstring.customTemplatePath": "..\\utilities\\python related\\python_autodocstring_extension_template.mustache",
  // =====================================
  // Ruff formatter/linter settings (python)
  "ruff.configuration": "..\\utilities\\python related\\good_Ruff_settings.toml",
  "ruff.configurationPreference": "filesystemFirst", //"filesystemFirst" "editorFirst"
  "ruff.lint.enable": true,
  "ruff.lint.preview": false,
  "ruff.logLevel": "info",
  // =====================================
  // type checker settings (general)
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/.venv/**": true
  },
  // =====================================
  // pyrefly - type checker and LSP (alternative to pylance)
  "python.languageServer": "None", //"None" == pyrefly ; "Default"=Pylance
  "python.pyrefly.typeCheckingMode": "default", //"off"/"basic"/"auto"/"default"/"strict"
  "python.pyrefly.disableTypeErrors": false,
  // =====================================
  // buttons in GUI using "commands"-extension
  "commands.commands": {
    "Toggle unchanged diff regions": {
      "command": "commands.toggleSetting",
      "args": {
        "setting": "diffEditor.hideUnchangedRegions.enabled",
        "value": [
          true,
          false
        ],
        "target": "workspace"
      },
      "statusBar": {
        "alignment": "right",
        "name": "Unchanged diff regions",
        "text": "$(map)=${config:diffEditor.hideUnchangedRegions.enabled}",
        "tooltip": "Toggle hiding unchanged regions in diff editors for this workspace.",
        "updateEvents": [
          {
            "kind": "onDidConfigurationChange",
            "settings": [
              "diffEditor.hideUnchangedRegions.enabled"
            ]
          }
        ],
        "replaceVariableValue": {
          "config:diffEditor.hideUnchangedRegions.enabled": {
            "true": "on",
            "false": "off"
          }
        }
      }
    },
    "Pyrefly type checking": {
      "nestedItems": {
        "Off": {
          "sequence": [
            {
              "command": "commands.toggleSetting",
              "args": {
                "setting": "python.pyrefly.configPath",
                "value": "",
                "target": "workspace"
              }
            },
            {
              "command": "commands.toggleSetting",
              "args": {
                "setting": "python.pyrefly.typeCheckingMode",
                "value": "off",
                "target": "workspace"
              }
            },
            {
              "command": "commands.toggleSetting",
              "args": {
                "setting": "python.pyrefly.disableTypeErrors",
                "value": [
                  true,
                  true
                ],
                "target": "workspace"
              }
            },
            "pyrefly.restartClient"
          ]
        },
        "Basic": {
          "sequence": [
            {
              "command": "commands.toggleSetting",
              "args": {
                "setting": "python.pyrefly.configPath",
                "value": "",
                "target": "workspace"
              }
            },
            {
              "command": "commands.toggleSetting",
              "args": {
                "setting": "python.pyrefly.typeCheckingMode",
                "value": "basic",
                "target": "workspace"
              }
            },
            {
              "command": "commands.toggleSetting",
              "args": {
                "setting": "python.pyrefly.disableTypeErrors",
                "value": [
                  false,
                  false
                ],
                "target": "workspace"
              }
            },
            "pyrefly.restartClient"
          ]
        },
        "Default": {
          "sequence": [
            {
              "command": "commands.toggleSetting",
              "args": {
                "setting": "python.pyrefly.configPath",
                "value": "",
                "target": "workspace"
              }
            },
            {
              "command": "commands.toggleSetting",
              "args": {
                "setting": "python.pyrefly.typeCheckingMode",
                "value": "default",
                "target": "workspace"
              }
            },
            {
              "command": "commands.toggleSetting",
              "args": {
                "setting": "python.pyrefly.disableTypeErrors",
                "value": [
                  false,
                  false
                ],
                "target": "workspace"
              }
            },
            "pyrefly.restartClient"
          ]
        },
        "Strict": {
          "sequence": [
            {
              "command": "commands.toggleSetting",
              "args": {
                "setting": "python.pyrefly.configPath",
                "value": "",
                "target": "workspace"
              }
            },
            {
              "command": "commands.toggleSetting",
              "args": {
                "setting": "python.pyrefly.typeCheckingMode",
                "value": "strict",
                "target": "workspace"
              }
            },
            {
              "command": "commands.toggleSetting",
              "args": {
                "setting": "python.pyrefly.disableTypeErrors",
                "value": [
                  false,
                  false
                ],
                "target": "workspace"
              }
            },
            "pyrefly.restartClient"
          ]
        },
        "Custom": {
          "sequence": [
            {
              "command": "commands.toggleSetting",
              "args": {
                "setting": "python.pyrefly.configPath",
                "value": "${workspaceFolder}/pyrefly.custom.toml",
                "target": "workspace"
              }
            },
            {
              "command": "commands.toggleSetting",
              "args": {
                "setting": "python.pyrefly.typeCheckingMode",
                "value": "auto",
                "target": "workspace"
              }
            },
            {
              "command": "commands.toggleSetting",
              "args": {
                "setting": "python.pyrefly.disableTypeErrors",
                "value": [
                  false,
                  false
                ],
                "target": "workspace"
              }
            },
            "pyrefly.restartClient"
          ]
        },
        "Edit Custom settings": {
          "command": "vscode.open",
          "args": "file:///${workspaceFolder}/pyrefly.custom.toml"
        }
      },
      "statusBar": {
        "alignment": "right",
        "name": "Pyrefly type checking",
        "text": "Pyrefly: ${config:python.pyrefly.typeCheckingMode} $(chevron-down)",
        "tooltip": "Choose Off, Basic, Default, Strict, or Custom. Edit Custom settings opens pyrefly.custom.toml.",
        "activeEditorLanguage": "python",
        "replaceVariableValue": {
          "config:python.pyrefly.typeCheckingMode": {
            "\"off\"": "Off",
            "\"basic\"": "Basic",
            "\"default\"": "Default",
            "\"strict\"": "Strict",
            "\"auto\"": "Custom"
          }
        },
        "updateEvents": [
          {
            "kind": "onDidConfigurationChange",
            "settings": [
              "python.pyrefly.typeCheckingMode",
              "python.pyrefly.configPath",
              "python.pyrefly.disableTypeErrors"
            ]
          }
        ]
      }
    },
    "Run current C# project": {
      "command": "commands.runInTerminal",
      "args": {
        "text": "\u0003@powershell -NoProfile -Command \"$dir = '${fileDirname}'; while ($dir -and -not (Get-ChildItem -LiteralPath $dir -Filter *.csproj -File -ErrorAction SilentlyContinue)) { $parent = Split-Path $dir -Parent; if ($parent -eq $dir) { break }; $dir = $parent }; $project = Get-ChildItem -LiteralPath $dir -Filter *.csproj -File | Select-Object -First 1; if (-not $project) { Write-Error 'No .csproj found above the active file'; exit 1 }; $exe = Get-ChildItem -LiteralPath (Join-Path $dir 'bin') -Filter ($project.BaseName + '.exe') -File -Recurse -ErrorAction SilentlyContinue | Sort-Object LastWriteTime -Descending | Select-Object -First 1; if (-not $exe) { Write-Error 'No compiled EXE found. Build the project first.'; exit 1 }; $configuration = if ($exe.FullName -match '\\\\bin\\\\Debug\\\\') { 'Debug' } elseif ($exe.FullName -match '\\\\bin\\\\Release\\\\') { 'Release' } else { 'Unknown' }; Write-Host ''; Write-Host '============================================================'; Write-Host ('Running:    ' + $configuration); Write-Host ('Built:      ' + $exe.LastWriteTime.ToString('yyyy-MM-dd HH:mm:ss')); Write-Host ('Path:       ' + $exe.FullName); Write-Host '============================================================'; Write-Host ''; & $exe.FullName\"",
        "name": "C# EXE",
        "reuse": "newest",
        "reveal": true
      },
      "activeEditorGlob": "**/*.{cs,csproj,xml,config,resx,props,targets,xaml}",
      "statusBar": {
        "text": "$(play) Run EXE",
        "alignment": "right",
        "priority": 100,
        "tooltip": "Run the newest compiled EXE for the active C# project",
        "activeEditorGlob": "**/*.{cs,csproj,xml,config,resx,props,targets,xaml}",
      }
    },
    "Copilot autocomplete": {
      "sequence": [
        {
          "command": "commands.toggleSetting",
          "args": {
            "setting": "github.copilot.enable",
            "value": [
              {
                "*": false,
                "python": true
              },
              {
                "*": false,
                "python": false
              }
            ],
            "target": "workspace"
          }
        },
        {
          "command": "commands.toggleSetting",
          "args": {
            "setting": "github.copilot.nextEditSuggestions.enabled",
            "value": [
              true,
              false
            ],
            "target": "workspace"
          }
        }
      ],
      "statusBar": {
        "alignment": "right",
        "priority": 100.09,
        "name": "Copilot autocomplete",
        "text": "$(copilot)=${config:github.copilot.nextEditSuggestions.enabled}",
        "tooltip": "Toggle Python autocomplete and Next Edit Suggestions.",
        "replaceVariableValue": {
          "config:github.copilot.nextEditSuggestions.enabled": {
            "true": "on",
            "false": "off"
          }
        },
        "updateEvents": [
          {
            "kind": "onDidConfigurationChange",
            "settings": [
              "github.copilot.enable",
              "github.copilot.nextEditSuggestions.enabled"
            ]
          }
        ]
      }
    }
  }, // =====================================
  "NEW_SETTINGS_ARE_BELOW": "", // NEW SETTINGS ARE BELOW
}